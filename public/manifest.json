{
  "manifest_version": 3,
  "name": "RenewTube",
  "version": "0.8.1",
  "author": "OpenCourse",
  "description": "유튜브 화면을 심플하고 쉬운 재생기로 바꿉니다. 음악과 영상을 한자리에서 다루며, 언제든 원래 화면으로 돌아갑니다.",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://*.youtube.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.youtube.com/*"
      ],
      "js": [
        "isolated.js"
      ],
      "run_at": "document_start",
      "all_frames": false,
      "exclude_matches": [
        "https://music.youtube.com/*"
      ]
    },
    {
      "matches": [
        "https://*.youtube.com/*"
      ],
      "js": [
        "main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false,
      "exclude_matches": [
        "https://music.youtube.com/*"
      ]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "RenewTube"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "main.js"
      ],
      "matches": [
        "https://*.youtube.com/*"
      ]
    }
  ]
}
